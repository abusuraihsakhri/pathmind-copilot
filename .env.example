# Generate a distinct production key; never commit real secrets.
# python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# Optional: required to read the audit chain via GET /api/audit/logs.
# Set a different random token from AUDIT_SECRET_KEY; send as X-Audit-Token.
AUDIT_READ_TOKEN=

# Only the deterministic mock is implemented; no external model calls.
MODEL_PROVIDER=mock
